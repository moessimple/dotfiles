root = true

# shfmt's settings for bin/format.sh. [[shell]] is shfmt's own section that matches by shebang, outside the
# EditorConfig spec. Google's shell style as shfmt documents it (-ci -bn), with this repository's 4-space indent.
[[shell]]
indent_style = space
indent_size = 4
binary_next_line = true
switch_case_indent = true

# Third-party skills stay as their authors wrote them, since update reinstalls them from upstream. Keep this list in
# sync with THIRD_PARTY_SKILLS in support/setup/claude/claude-skills.sh.
[home/.claude/skills/{clarity,diagnosing-bugs,pdf,skill-creator,speeding-up-laravel-tests}/**]
ignore = true
