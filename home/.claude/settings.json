{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "PHP_MEMORY_LIMIT": "2G",
    "IMPECCABLE_NO_TELEMETRY": "1"
  },
  "permissions": {
    "allow": [
      "Bash(cat *)",
      "Bash(composer lint *)",
      "Bash(composer test *)",
      "Bash(cut *)",
      "Bash(date *)",
      "Bash(diff *)",
      "Bash(echo *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(head *)",
      "Bash(ls *)",
      "Bash(php artisan test *)",
      "Bash(pwd *)",
      "Bash(quality *)",
      "Bash(sort *)",
      "Bash(tail *)",
      "Bash(tr *)",
      "Bash(uniq *)",
      "Bash(vendor/bin/pest *)",
      "Bash(vendor/bin/phpstan *)",
      "Bash(vendor/bin/phpunit *)",
      "Bash(vendor/bin/pint *)",
      "Bash(wc *)",
      "Bash(which *)",
      "Bash(whoami *)",
      "mcp__chrome-devtools__*",
      "mcp__laravel-boost__*",
      "Skill(agent-browser:*)",
      "Skill(spatie-laravel-php:*)",
      "WebFetch",
      "WebSearch"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(security find-generic-password *)",
      "Bash(sudo *)",
      "Edit(**/*.jks)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pem)",
      "Edit(**/*.pfx)",
      "Edit(**/.aws/**)",
      "Edit(**/.gnupg/**)",
      "Edit(**/.ssh/**)",
      "Edit(**/auth.json)",
      "Edit(**/credentials/**)",
      "Edit(**/id_ed25519)",
      "Edit(**/id_rsa)",
      "Edit(**/secrets/**)",
      "Read(**/*.jks)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/.aws/credentials)",
      "Read(**/.gnupg/**)",
      "Read(**/auth.json)",
      "Read(**/credentials/**)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/id_rsa)",
      "Read(**/secrets/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.git-credentials)",
      "Read(~/.npmrc)",
      "Read(~/Library/Keychains/**)"
    ],
    "ask": [
      "Bash(gh pr comment *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr review *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(rm *)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.aws/**)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.codex/config.toml)",
      "Read(~/.ssh/**)"
    ],
    "defaultMode": "auto"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/post-edit.sh\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/require-evidence.sh\"",
            "timeout": 120
          }
        ]
      }
    ]
  },
  "disableRemoteControl": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "laravel@laravel": true,
    "agent-browser@agent-browser": true,
    "agent-skills@addy-agent-skills": true,
    "claude-md-management@claude-plugins-official": true,
    "php-lsp-herd@skills-dir": true,
    "laravel-lsp@skills-dir": true,
    "typescript-lsp@claude-plugins-official": true,
    "web-quality-skills@addy-web-quality-skills": true,
    "impeccable@impeccable": true,
    "context7@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "addy-agent-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/addyosmani/agent-skills.git"
      },
      "autoUpdate": false
    },
    "laravel": {
      "source": {
        "source": "git",
        "url": "https://github.com/laravel/claude-code.git"
      },
      "autoUpdate": false
    },
    "agent-browser": {
      "source": {
        "source": "git",
        "url": "https://github.com/vercel-labs/agent-browser.git"
      },
      "autoUpdate": false
    },
    "claude-plugins-official": {
      "source": {
        "source": "git",
        "url": "https://github.com/anthropics/claude-plugins-official.git"
      },
      "autoUpdate": false
    },
    "addy-web-quality-skills": {
      "source": {
        "source": "git",
        "url": "https://github.com/addyosmani/web-quality-skills.git"
      },
      "autoUpdate": false
    },
    "impeccable": {
      "source": {
        "source": "git",
        "url": "https://github.com/pbakaus/impeccable.git"
      },
      "autoUpdate": false
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Thinking"
    ]
  },
  "syntaxHighlightingDisabled": false,
  "alwaysThinkingEnabled": true,
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "autoMemoryEnabled": false,
  "theme": "dark",
  "agentPushNotifEnabled": false,
  "skipAutoPermissionPrompt": true
}
