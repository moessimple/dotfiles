#!/usr/bin/env bash
# Intelephense determines its target PHP version by running `php -v` on
# PATH itself; without this, that would hit the static global Herd symlink
# instead of a project's isolated version. Resolved once here via `herd
# which-php` and exposed as a plain symlink ahead of PATH, so nothing on
# PATH ever re-invokes `herd` and there is no recursion to guard against.
php_bin="$(command -v herd >/dev/null 2>&1 && herd which-php 2>/dev/null)"
if [[ -x "$php_bin" ]]; then
    shim_dir="$(mktemp -d)"
    ln -s "$php_bin" "$shim_dir/php"
    PATH="$shim_dir:$PATH"
fi
exec intelephense "$@"
