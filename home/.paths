#!/usr/bin/env zsh

# zsh keeps only the first occurrence of each PATH entry, including entries that brew shellenv
# or Herd add later, so the shell reloads without growing PATH.
typeset -U path PATH

# Each directory is put in front of PATH when it exists; (N-/) drops one that does not.
path=(~/.local/bin(N-/) $path)
path=(~/.composer/vendor/bin(N-/) $path)
path=(~/.gem/bin(N-/) $path)

# HOMEBREW_PREFIX comes from `brew shellenv` in .zprofile.
if [[ -n "$HOMEBREW_PREFIX" ]]; then
    path=($HOMEBREW_PREFIX/bin(N-/) $path)
    path=($HOMEBREW_PREFIX/sbin(N-/) $path)
    path=($HOMEBREW_PREFIX/opt/coreutils/libexec/gnubin(N-/) $path)
    path=($HOMEBREW_PREFIX/opt/libxml2/bin(N-/) $path)
    path=($HOMEBREW_PREFIX/opt/ruby/bin(N-/) $path)
fi
