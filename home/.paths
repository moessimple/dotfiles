#!/usr/bin/env zsh

# zsh keeps only the first occurrence of each PATH entry, including entries that brew shellenv
# or Herd add later, so the shell reloads without growing PATH.
typeset -U path PATH

# Each directory is put in front of PATH when it exists; (N-/) drops one that does not.
path=($DOTFILES_DIR/bin(N-/) $path)
path=(~/.composer/vendor/bin(N-/) $path)
path=(~/.gem/bin(N-/) $path)

if command -v brew &>/dev/null; then
    BREW_PREFIX="$(brew --prefix)"
    path=($BREW_PREFIX/bin(N-/) $path)
    path=($BREW_PREFIX/sbin(N-/) $path)
    path=($BREW_PREFIX/opt/coreutils/libexec/gnubin(N-/) $path)
    path=($BREW_PREFIX/opt/libxml2/bin(N-/) $path)
    path=($BREW_PREFIX/opt/ruby/bin(N-/) $path)
    unset BREW_PREFIX
fi
